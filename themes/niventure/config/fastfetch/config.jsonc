{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "logo": {
    "type": "small",
    "source": "cachyos"
  },

  "display": {
    "separator": "",
    "key": {
      "width": 20,
      "type": "both"
    }
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "Nivox Base",
      "format": "{name} {version}" 
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Time of Life",
      "format": "{hours}h {minutes}min"
    },
    "packages",
    {
      "type": "memory",
      "key": "RAM Usage",
      "format": "{used} out of {total}"
    }
  ]
}
